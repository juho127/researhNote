{
  "name": "research-note",
  "version": "1.0.0",
  "private": true,
  "description": "연구실 논문 진행 기록·공유 시스템 (Cloudflare Workers + D1 + MCP)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "bootstrap": "node scripts/bootstrap-admin.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "test": "node tests/smoke.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.129.0"
  }
